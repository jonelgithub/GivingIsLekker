# Server Configuration
PORT=8080
NODE_ENV=development

# Security Settings
LOCAL_API_KEY=local_dev_api_key_12345
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Downstream API Configuration
# Allowed values: mock, sandbox, production
TARGET_ENV=mock

# Downstream API Credentials
# (Required if TARGET_ENV is 'sandbox' or 'production')
CLIENT_ID=
CLIENT_SECRET=
API_KEY=
