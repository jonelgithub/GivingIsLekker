{
  "openapi": "3.0.0",
  "info": {
    "title": "Bank API Proxy",
    "version": "1.0.0",
    "description": "Secure Node.js & TypeScript proxy server integrating with banking API endpoints. Features local API Key authentication, input validation, and a stateful in-memory Mock Mode for local testing.",
    "contact": {
      "name": "Developer Support",
      "url": "https://github.com"
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "Local API Router Namespace"
    }
  ],
  "security": [
    {
      "LocalApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Retrieve system status and environment mode",
        "description": "Returns status information indicating if the proxy is running and whether it is connected to a live Investec Sandbox/Production environment or running in Mock Mode.",
        "security": [],
        "responses": {
          "200": {
            "description": "System status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "online" },
                    "timestamp": { "type": "string", "example": "2026-05-30T10:00:00.000Z" },
                    "environment": { "type": "string", "example": "mock" },
                    "mode": { "type": "string", "example": "MOCK (Stateful In-Memory)" },
                    "version": { "type": "string", "example": "1.0.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pb/accounts": {
      "get": {
        "summary": "List Private/Business accounts",
        "description": "Retrieves the list of Private Banking (and optionally Business Banking if authorized) accounts associated with the profile.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter accounts by type",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["private", "business"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "accounts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Account"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" }
        }
      }
    },
    "/pb/accounts/{accountId}/balance": {
      "get": {
        "summary": "Get account balance",
        "description": "Retrieves current and available balance for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "The unique account ID",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Account balance details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Balance" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/pb/accounts/{accountId}/transactions": {
      "get": {
        "summary": "Get account transactions",
        "description": "Retrieves the list of transactions for a specific account, optionally filtered by posting date range or transaction type.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "The unique account ID",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "fromDate",
            "in": "query",
            "description": "Filter transactions starting from this date (format YYYY-MM-DD)",
            "required": false,
            "schema": { "type": "string", "format": "date", "example": "2026-05-01" }
          },
          {
            "name": "toDate",
            "in": "query",
            "description": "Filter transactions up to this date (format YYYY-MM-DD)",
            "required": false,
            "schema": { "type": "string", "format": "date", "example": "2026-05-30" }
          },
          {
            "name": "transactionType",
            "in": "query",
            "description": "Filter transactions by type",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["DEBIT", "CREDIT"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of transactions matching the query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "transactions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Transaction"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/pb/beneficiaries": {
      "get": {
        "summary": "List beneficiaries",
        "description": "Retrieves the list of pre-approved EFT beneficiaries linked to the account profile.",
        "responses": {
          "200": {
            "description": "A list of pre-approved beneficiaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "beneficiaries": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Beneficiary"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" }
        }
      }
    },
    "/pb/accounts/{accountId}/paymultiple": {
      "post": {
        "summary": "Pay multiple beneficiaries",
        "description": "Initiates payments to one or more pre-approved beneficiaries. Note: For security, a beneficiary must have received at least one payment via Online Banking prior to API use.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "The source account ID to pay from",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["paymentList"],
                "properties": {
                  "paymentList": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["beneficiaryId", "amount", "myReference", "theirReference"],
                      "properties": {
                        "beneficiaryId": { "type": "string", "example": "ben_eskom_001" },
                        "amount": { "type": "string", "example": "150.00", "description": "Payment amount in ZAR" },
                        "myReference": { "type": "string", "maxLength": 30, "example": "Eskom Bill May" },
                        "theirReference": { "type": "string", "maxLength": 30, "example": "Acc 987654321" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payments successfully submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentResponses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "paymentId": { "type": "string", "example": "pay_mock_a9b8c7" },
                          "status": { "type": "string", "example": "Submitted" },
                          "beneficiaryId": { "type": "string", "example": "ben_eskom_001" }
                        }
                      }
                    },
                    "message": { "type": "string", "example": "Payments successfully processed." }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/pb/accounts/{accountId}/transfermultiple": {
      "post": {
        "summary": "Transfer between own accounts",
        "description": "Initiates inter-account transfers to move funds between accounts belonging to the same profile.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "The source account ID to transfer from",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["transferList"],
                "properties": {
                  "transferList": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["beneficiaryAccountId", "amount", "myReference", "theirReference"],
                      "properties": {
                        "beneficiaryAccountId": { "type": "string", "example": "acc_pb_sav_67890" },
                        "amount": { "type": "string", "example": "500.00", "description": "Transfer amount in ZAR" },
                        "myReference": { "type": "string", "maxLength": 30, "example": "Move to savings" },
                        "theirReference": { "type": "string", "maxLength": 30, "example": "Deposit from PB" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transfers completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transferResponses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "transferId": { "type": "string", "example": "trn_mock_d4e5f6" },
                          "status": { "type": "string", "example": "Completed" },
                          "beneficiaryAccountId": { "type": "string", "example": "acc_pb_sav_67890" }
                        }
                      }
                    },
                    "message": { "type": "string", "example": "Transfers successfully processed." }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/pb/accounts/{accountId}/pay-direct": {
      "post": {
        "summary": "Pay beneficiary directly by account number",
        "description": "Resolves the destination account number against the pre-approved beneficiaries list, automatically finds the beneficiaryId, and executes the EFT payment.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "The source account ID to pay from",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["accountNumber", "amount", "myReference", "theirReference"],
                "properties": {
                  "accountNumber": { "type": "string", "example": "98765432101" },
                  "amount": { "type": "string", "example": "2.50", "description": "EFT payment amount in ZAR" },
                  "myReference": { "type": "string", "maxLength": 30, "example": "RoundUp Donation" },
                  "theirReference": { "type": "string", "maxLength": 30, "example": "RoundUp Contrib" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment successfully resolved and completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentResponses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "paymentId": { "type": "string", "example": "pay_mock_c8d9e2" },
                          "status": { "type": "string", "example": "Submitted" },
                          "beneficiaryId": { "type": "string", "example": "ben_charity_imbumba" }
                        }
                      }
                    },
                    "message": { "type": "string", "example": "Payments successfully processed in Mock Mode." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failure or beneficiary is not pre-approved (returns BENEFICIARY_NOT_APPROVED)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "BENEFICIARY_NOT_APPROVED" },
                    "message": { "type": "string", "example": "Beneficiary with account number 98765432101 is not pre-approved on your Investec profile." }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/UnauthorizedError" },
          "403": { "$ref": "#/components/responses/ForbiddenError" },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    },
    "/mock/accounts": {
      "post": {
        "summary": "Register custom mock account",
        "description": "Dynamically populates a new mock account into the stateful in-memory database. Only accessible in Mock Mode.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["accountId", "accountNumber", "accountName", "referenceName", "productName", "accountType"],
                "properties": {
                  "accountId": { "type": "string", "example": "892019481720" },
                  "accountNumber": { "type": "string", "example": "20087654321" },
                  "accountName": { "type": "string", "example": "Investec Private Cash" },
                  "referenceName": { "type": "string", "example": "Transaction Account" },
                  "productName": { "type": "string", "example": "Private Cash Account" },
                  "accountType": { "type": "string", "enum": ["private", "business"], "example": "private" },
                  "initialBalance": { "type": "number", "example": 1000.00 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mock account successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Mock account registered successfully." },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": {
            "description": "Attempted to register mock data when not in Mock Mode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Forbidden" },
                    "message": { "type": "string", "example": "Mock endpoints are only accessible when TARGET_ENV is set to mock." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mock/beneficiaries": {
      "post": {
        "summary": "Register custom mock beneficiary",
        "description": "Dynamically registers a pre-approved beneficiary into the stateful in-memory database. Only accessible in Mock Mode.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["beneficiaryId", "accountNumber", "code", "bank", "beneficiaryName", "paymentType"],
                "properties": {
                  "beneficiaryId": { "type": "string", "example": "ben_charity_imbumba" },
                  "accountNumber": { "type": "string", "example": "98765432101" },
                  "code": { "type": "string", "example": "250655" },
                  "bank": { "type": "string", "example": "Standard Bank" },
                  "beneficiaryName": { "type": "string", "example": "Imbumba Foundation" },
                  "paymentType": { "type": "string", "example": "Electronic EFT" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mock beneficiary successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Mock beneficiary registered successfully." },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": {
            "description": "Attempted to register mock data when not in Mock Mode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Forbidden" },
                    "message": { "type": "string", "example": "Mock endpoints are only accessible when TARGET_ENV is set to mock." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mock/webhook/register": {
      "post": {
        "summary": "Register webhook URL for transactions",
        "description": "Registers a client endpoint URL to receive simulated card swipe notifications. Only accessible in Mock Mode.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["webhookUrl"],
                "properties": {
                  "webhookUrl": { "type": "string", "example": "http://localhost:3000/api/investec/webhook" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Webhook URL registered successfully." },
                    "webhookUrl": { "type": "string", "example": "http://localhost:3000/api/investec/webhook" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": {
            "description": "Attempted to register webhook when not in Mock Mode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Forbidden" },
                    "message": { "type": "string", "example": "Mock endpoints are only accessible when TARGET_ENV is set to mock." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mock/trigger-swipe": {
      "post": {
        "summary": "Simulate card swipe",
        "description": "Simulates a physical card swipe. Updates the mock account balance in memory, logs a DEBIT transaction, and dispatches the standard Investec Webhook event structure to the registered URL. Only accessible in Mock Mode.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["accountId", "amount", "merchant"],
                "properties": {
                  "accountId": { "type": "string", "example": "892019481720" },
                  "amount": { "type": "number", "example": 42.50 },
                  "merchant": { "type": "string", "example": "Woolworths Cape Town" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Swipe simulated successfully and webhook dispatched",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Swipe simulated successfully." },
                    "transaction": { "$ref": "#/components/schemas/Transaction" },
                    "webhookStatus": { "type": "string", "example": "delivered" },
                    "webhookPayload": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": {
            "description": "Attempted to simulate swipe when not in Mock Mode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "Forbidden" },
                    "message": { "type": "string", "example": "Mock endpoints are only accessible when TARGET_ENV is set to mock." }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFoundError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Local-API-Key",
        "description": "Your custom API key protecting the middleware proxy layer. Default: `local_dev_api_key_12345`"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Alternative authorization header using Bearer format."
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string", "example": "acc_pb_12345" },
          "accountNumber": { "type": "string", "example": "10012345678" },
          "accountName": { "type": "string", "example": "John Doe Private Banker" },
          "referenceName": { "type": "string", "example": "PB Single Account" },
          "productName": { "type": "string", "example": "Private Bank Account" },
          "accountType": { "type": "string", "enum": ["private", "business"], "example": "private" }
        }
      },
      "Balance": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string", "example": "acc_pb_12345" },
          "currentBalance": { "type": "number", "format": "float", "example": 50230.12 },
          "availableBalance": { "type": "number", "format": "float", "example": 48900.5 },
          "currency": { "type": "string", "example": "ZAR" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string", "example": "acc_pb_12345" },
          "type": { "type": "string", "enum": ["DEBIT", "CREDIT"], "example": "DEBIT" },
          "status": { "type": "string", "enum": ["POSTED", "PENDING"], "example": "POSTED" },
          "description": { "type": "string", "example": "Woolworths Food Cape Town" },
          "amount": { "type": "number", "format": "float", "example": 450.2 },
          "postingDate": { "type": "string", "format": "date", "example": "2026-05-28" },
          "valueDate": { "type": "string", "format": "date", "example": "2026-05-28" },
          "actionDate": { "type": "string", "format": "date", "example": "2026-05-28" },
          "transactionDate": { "type": "string", "format": "date-time", "example": "2026-05-28T14:22:00Z" },
          "transactionId": { "type": "string", "example": "tx_pb_001" }
        }
      },
      "Beneficiary": {
        "type": "object",
        "properties": {
          "beneficiaryId": { "type": "string", "example": "ben_eskom_001" },
          "accountNumber": { "type": "string", "example": "4089123456" },
          "code": { "type": "string", "example": "250655" },
          "bank": { "type": "string", "example": "Standard Bank" },
          "beneficiaryName": { "type": "string", "example": "Eskom Holdings" },
          "paymentType": { "type": "string", "example": "Electronic EFT" }
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Local API key is missing or not provided",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Unauthorized" },
                "message": { "type": "string", "example": "Local API security key is missing." }
              }
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "Provided API key is invalid",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "Forbidden" },
                "message": { "type": "string", "example": "Invalid local API security key." }
